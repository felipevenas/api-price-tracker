# Global settings
PROJECT_NAME="Price Monitor API"
API_V1_STR="/api/v1"
ENV=development # Options: development | production

# Security and authentication
SECRET_KEY=SUPER_SECRET_KEY_CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days in minutes

# PostgreSQL database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=price_monitor
POSTGRES_PORT=5432
# ASYNC_DATABASE_URI is assembled automatically when omitted, but can be set explicitly:
# ASYNC_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/price_monitor

# Queue and broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Scraping and e-commerce APIs
SELENIUM_HUB_URL=http://localhost:4444/wd/hub
MERCADO_LIVRE_CLIENT_ID=your_client_id_here
MERCADO_LIVRE_CLIENT_SECRET=your_client_secret_here
